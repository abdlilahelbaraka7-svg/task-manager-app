/* ---------- Design-Tokens ---------- */
:root {
  --spruce: #1e4d46;
  --spruce-dark: #153833;
  --mist: #f2f5f4;
  --sand: #e7e0d3;
  --ink: #16231f;
  --muted: #5b6b66;
  --amber: #d08a2e;
  --white: #fff;
  --radius: 10px;
  --font-head: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
 
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 80px; }
body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--ink);
  background: var(--white);
}
img, svg { max-width: 100%; }
a { color: inherit; }
h1, h2, h3 { font-family: var(--font-head); line-height: 1.15; margin: 0; }
 
.container { width: min(1120px, 100% - 2.5rem); margin-inline: auto; }
.visually-hidden {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}
:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
 
/* ---------- Header ---------- */
.site-header {
  position: sticky; top: 0; z-index: 50;
  background: var(--spruce-dark);
  color: var(--white);
}
.header-inner {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 68px;
}
.logo {
  display: inline-flex; align-items: center; gap: .6rem;
  text-decoration: none;
  font-family: var(--font-head); font-weight: 700; font-size: 1.3rem;
}
.logo small { font-weight: 500; opacity: .8; font-size: 1rem; }
 
.main-nav ul { display: flex; align-items: center; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
.main-nav a { text-decoration: none; font-weight: 500; padding: .35rem 0; border-bottom: 2px solid transparent; }
.main-nav a:hover { border-bottom-color: var(--amber); }
.main-nav .nav-cta {
  background: var(--amber); color: var(--ink);
  padding: .5rem 1.1rem; border-radius: 999px; border-bottom: 0;
}
.main-nav .nav-cta:hover { background: #e0a047; }
 
.nav-toggle { display: none; background: none; border: 0; padding: .75rem; cursor: pointer; color: inherit; }
.nav-toggle__bar,
.nav-toggle__bar::before,
.nav-toggle__bar::after {
  display: block; width: 24px; height: 2px; background: currentColor;
  transition: transform .2s, opacity .2s;
}
.nav-toggle__bar { position: relative; }
.nav-toggle__bar::before, .nav-toggle__bar::after { content: ""; position: absolute; left: 0; }
.nav-toggle__bar::before { top: -7px; }
.nav-toggle__bar::after { top: 7px; }
.nav-toggle[aria-expanded="true"] .nav-toggle__bar { background: transparent; }
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::before { transform: translateY(7px) rotate(45deg); }
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::after { transform: translateY(-7px) rotate(-45deg); }
 
/* ---------- Hero ---------- */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, var(--spruce) 0%, var(--spruce-dark) 100%);
  color: var(--white);
  padding: clamp(4rem, 10vw, 7.5rem) 0 clamp(6rem, 12vw, 9rem);
}
.hero-inner { position: relative; z-index: 1; }
.hero h1 {
  font-size: clamp(2.4rem, 6.5vw, 4.75rem);
  font-weight: 700;
  max-width: 14ch;
  letter-spacing: -.01em;
}
.hero-text { max-width: 52ch; margin: 1.5rem 0 0; font-size: 1.2rem; opacity: .9; }
.hero-roofline { position: absolute; left: 0; bottom: 0; width: 100%; height: 55%; }
 
/* ---------- Suchleiste ---------- */
.search {
  position: relative; z-index: 2;
  display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 1rem; align-items: end;
  margin-top: -3.25rem;
  padding: 1.25rem 1.5rem;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: 0 14px 40px rgba(22, 35, 31, .18);
}
.field { display: flex; flex-direction: column; gap: .3rem; }
.field label { font-size: .9rem; font-weight: 600; color: var(--muted); }
.field input, .field select {
  font: inherit; color: inherit;
  padding: .7rem .85rem;
  border: 1.5px solid #cdd6d3; border-radius: 8px;
  background: var(--white);
  min-height: 48px;
}
.field input:focus, .field select:focus { border-color: var(--spruce); outline-offset: 1px; }
 
.btn {
  font: inherit; font-weight: 600; cursor: pointer;
  min-height: 48px; padding: .7rem 1.5rem;
  background: var(--spruce); color: var(--white);
  border: 0; border-radius: 8px;
  transition: background .15s;
}
.btn:hover { background: var(--spruce-dark); }
 
/* ---------- Sektionen ---------- */
.section { padding: clamp(3.5rem, 8vw, 6rem) 0; }
.section-alt { background: var(--mist); }
.section-head {
  display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
  gap: .5rem 2rem; margin-bottom: 2rem;
}
.section h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
.result-info { margin: 0; color: var(--muted); }
 
/* ---------- Karten ---------- */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.75rem; }
.card {
  display: flex; flex-direction: column;
  background: var(--white);
  border: 1px solid #dde4e1;
  border-radius: var(--radius);
  overflow: hidden;
}
.card[hidden] { display: none; }
.card-img {
  position: relative; display: grid; place-items: center;
  aspect-ratio: 16 / 10; color: rgba(255, 255, 255, .85);
}
.img-a { background: linear-gradient(135deg, #3d6b63, #1e4d46); }
.img-b { background: linear-gradient(135deg, #b9a47c, #8a7447); }
.img-c { background: linear-gradient(135deg, #5d7d95, #34506a); }
.badge {
  position: absolute; top: .9rem; left: .9rem;
  background: var(--white); color: var(--ink);
  font-size: .85rem; font-weight: 600;
  padding: .25rem .7rem; border-radius: 999px;
}
.card-body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem 1.4rem 1.4rem; }
.card h3 { font-size: 1.35rem; }
.location { margin: .3rem 0 0; color: var(--muted); }
.facts {
  display: flex; flex-wrap: wrap; gap: .4rem 1.1rem;
  list-style: none; margin: 1rem 0 0; padding: 1rem 0 0;
  border-top: 1px solid #e3e9e6; color: var(--muted); font-size: .98rem;
}
.facts strong { color: var(--ink); }
.card-foot {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  margin-top: auto; padding-top: 1.25rem;
}
.price { margin: 0; font-family: var(--font-head); font-size: 1.5rem; font-weight: 700; color: var(--spruce); }
.link { font-weight: 600; color: var(--spruce); text-underline-offset: 4px; }
.link:hover { color: var(--amber); }
 
.empty { margin: 1rem 0 0; padding: 1.25rem; background: var(--sand); border-radius: var(--radius); }
.empty[hidden] { display: none; }
 
/* ---------- Über uns ---------- */
.about { max-width: 720px; }
.about p { margin: 1rem 0 0; font-size: 1.15rem; }
 
/* ---------- Footer ---------- */
.site-footer { background: var(--spruce-dark); color: rgba(255, 255, 255, .88); padding-top: 3.5rem; }
.footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; }
.site-footer p { margin: 0 0 .75rem; }
.site-footer address { font-style: normal; }
.site-footer a { text-underline-offset: 3px; }
.footer-title { font-family: var(--font-head); font-size: 1.2rem; font-weight: 700; color: var(--white); }
.footer-bottom {
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem;
  margin-top: 2.5rem; padding: 1.25rem 0 1.75rem;
  border-top: 1px solid rgba(255, 255, 255, .18);
  font-size: .92rem;
}
.footer-bottom p { margin: 0; }
 
/* ---------- Responsiv ---------- */
@media (max-width: 900px) {
  .search { grid-template-columns: 1fr 1fr; }
  .search .field:first-child { grid-column: 1 / -1; }
  .search .btn { grid-column: 1 / -1; }
}
 
@media (max-width: 760px) {
  .nav-toggle { display: block; }
  .main-nav {
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--spruce-dark);
    padding: .5rem 1.25rem 1.25rem;
    display: none;
  }
  .main-nav.open { display: block; }
  .main-nav ul { flex-direction: column; align-items: stretch; gap: .25rem; }
  .main-nav a { display: block; padding: .75rem 0; }
  .main-nav .nav-cta { text-align: center; margin-top: .5rem; }
}
 
@media (max-width: 480px) {
  .search { grid-template-columns: 1fr; margin-top: -2.5rem; }
}
 
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { transition: none !important; }
}
 
